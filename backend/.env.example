# Copy to `.env` (git-ignored). Secrets and credentials are intentionally blank.

# --- Server ---
NODE_ENV=development
PORT=5000
# Public URL of the frontend, used in password-reset links (production: https://app.example.com)
APP_URL=http://localhost:3000
# Comma-separated list of allowed frontend origins; required in production (https://app.example.com)
CORS_ORIGIN=http://localhost:3000
# Timezone used to compute "today", reminders and overdue items
APP_TIMEZONE=Africa/Casablanca
# Allow public self-registration (creates LAWYER accounts); use false in production
ALLOW_REGISTRATION=true

# --- Database ---
# postgresql://<user>:<password>@<host>:<port>/<database>?schema=public
DATABASE_URL=
# Only for `npm test` (defaults to a local legal_management_test database)
# TEST_DATABASE_URL=

# --- Auth (each at least 32 random characters, e.g. `openssl rand -hex 48`) ---
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
REFRESH_TOKEN_TTL_DAYS=7

# --- File storage ---
# local | s3 (any S3-compatible service: AWS S3, Cloudflare R2, Backblaze B2, MinIO...)
UPLOAD_PROVIDER=local
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=10
# Only when UPLOAD_PROVIDER=s3
UPLOAD_API_KEY=
UPLOAD_API_SECRET=
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT=

# --- Scheduler ---
# Run the reminder job inside the API process (cron expression below).
# On Render prefer the Cron Job service running `npm run job:reminders` and keep this false.
ENABLE_IN_PROCESS_SCHEDULER=false
REMINDER_CRON=0 * * * *

# --- Email (optional; needed for password-reset e-mails) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Legal Management <no-reply@example.com>"

# --- Demo data (`npm run db:seed`, development only) ---
# SEED_PASSWORD=
# SEED_FORCE=

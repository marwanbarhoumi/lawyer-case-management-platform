# Copy to `.env.local` (git-ignored). These values are read at build time.

# How the browser reaches the API — set ONE of the two:
# 1) Same-origin proxy (Vercel deployment): the app serves /api/* and forwards it to this origin (no trailing /).
# API_PROXY_TARGET=https://<your-service>.onrender.com
# 2) Direct calls (local development, Docker): base URL of the Express API.
NEXT_PUBLIC_API_URL=http://localhost:5000

# Timezone used to display and enter hearing dates (must match APP_TIMEZONE on the API)
NEXT_PUBLIC_APP_TIMEZONE=Africa/Tunis
# Client-side upload size check in MB (keep equal to MAX_UPLOAD_MB on the API)
NEXT_PUBLIC_MAX_UPLOAD_MB=10

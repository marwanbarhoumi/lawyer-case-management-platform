# Copy to `.env.local` (git-ignored). NEXT_PUBLIC_* values are inlined at build time.

# Base URL of the Express API, without trailing slash. Required for production builds.
# Production: https://api.example.com   Development: http://localhost:5000
NEXT_PUBLIC_API_URL=http://localhost:5000
# Timezone used to display and enter hearing dates (must match APP_TIMEZONE on the API)
NEXT_PUBLIC_APP_TIMEZONE=Africa/Tunis
# Client-side upload size check in MB (keep equal to MAX_UPLOAD_MB on the API)
NEXT_PUBLIC_MAX_UPLOAD_MB=10

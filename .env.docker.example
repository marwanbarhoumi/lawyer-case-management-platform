# Copy to `.env` (git-ignored) before running `docker compose up`.
POSTGRES_USER=legal
POSTGRES_PASSWORD=
POSTGRES_DB=legal_management

# Generate with: openssl rand -hex 48
JWT_SECRET=
JWT_REFRESH_SECRET=

APP_TIMEZONE=Africa/Tunis
ALLOW_REGISTRATION=true

# Host ports (change them if already in use)
POSTGRES_PORT=5440
API_PORT=5000
WEB_PORT=3000

# Password given to the demo accounts by the optional seed service
SEED_PASSWORD=
